# ── Backend ────────────────────────────────────────────────
# Required
GROQ_API_KEY=your_groq_api_key_here

# Optional — email escalation notifications
RESEND_API_KEY=your_resend_api_key_here
HUMAN_AGENT_EMAIL=support@yourcompany.com

# Database (SQLite default for dev)
DATABASE_URL=sqlite:///./resolva.db

# ChromaDB vector store path
# WARNING: Railway/Render free tier has ephemeral storage.
# Data resets on restart. Use Chroma Cloud for persistence.
CHROMA_DB_PATH=./chroma_db

# Escalation threshold (0.0–1.0). Higher = escalates more often.
CONFIDENCE_THRESHOLD=0.65

# API key to protect the /upload endpoint
UPLOAD_API_KEY=your-secret-upload-key-here

# Max file size for knowledge base uploads (MB)
MAX_UPLOAD_SIZE_MB=10

# ── Frontend ───────────────────────────────────────────────
VITE_API_URL=http://localhost:8000
VITE_UPLOAD_API_KEY=your-secret-upload-key-here
